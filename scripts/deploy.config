# ===================================================
# HeistHunt Firebase App Distribution 배포 설정
# 처음 한 번만 설정하면 됩니다.
# ===================================================

# Apple Developer Team ID
# Xcode > Signing & Capabilities > Team 옆 괄호 안 ID (예: A1B2C3D4E5)
APPLE_TEAM_ID=""

# Firebase App Distribution 테스터 이메일 (쉼표로 구분)
TESTER_EMAILS="loveany3131@gmail.com"

# Firebase 테스터 그룹 이름 (Firebase Console에서 생성한 그룹, 없으면 빈 칸)
TESTER_GROUP=""

# iOS 빌드 설정
IOS_SCHEME="iosApp"
IOS_CONFIGURATION="Debug"
IOS_SIMULATOR_DESTINATION="generic/platform=iOS"
